# Порт сервера
PORT=5000

# Код администратора. Если оставить пустым — сайт сам придумает код при первом запуске
# и покажет его в терминале. Введите код в кабинете: Профиль → «Доступ администратора».
ADMIN_CODE=

# Можно также сразу дать права админа по e-mail (через запятую)
ADMIN_EMAILS=

# Секрет для входа в аккаунты (минимум 32 символа). Если пусто — создаётся автоматически.
JWT_SECRET=

# Часовой пояс для «сегодня» (Ташкент — UTC+5)
TZ_OFFSET_HOURS=5

# Уведомления о заявках в Telegram (необязательно, бесплатно)
# 1) Создайте бота у @BotFather и вставьте токен
# 2) Напишите боту, затем узнайте chat_id: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Разрешённые домены для CORS через запятую (* — любой)
CORS_ORIGIN=*
